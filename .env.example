NODE_ENV=development

# Gateway
GATEWAY_PORT=3000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pulsegate
POSTGRES_USER=pulsegate
POSTGRES_PASSWORD=pulsegate

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (change in production - must be at least 32 characters)
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# Rate limiting (requests per minute per tier)
RATE_LIMIT_ANONYMOUS=30
RATE_LIMIT_USER=100
RATE_LIMIT_PREMIUM=500
RATE_LIMIT_ADMIN=500

# Health check interval in milliseconds
HEALTH_CHECK_INTERVAL=5000

# Backend request timeout in milliseconds
BACKEND_TIMEOUT=10000
